<%- include('partials/header') %>

  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="card shadow-md p-2">
        <div class="card-body p-4">
          <h2 class="h4 mb-4">Edit Your Post</h2>
          <p class="text-muted small mb-4">Updating your story to keep it fresh.</p>

          <form action="/posts/<%= post.id %>?_method=PATCH" method="POST">
            <div class="mb-4">
              <label for="username" class="form-label">Display Name</label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0">@</span>
                <input type="text" name="username" id="username" class="form-control border-start-0 ps-0"
                  value="<%= post.username %>" readonly>
              </div>
              <div class="form-text">Usernames cannot be changed.</div>
            </div>

            <div class="mb-4">
              <label for="content" class="form-label">Updated Content</label>
              <textarea name="content" id="content" rows="6" class="form-control"
                required><%= post.content %></textarea>
            </div>

            <div class="d-flex gap-2 pt-2">
              <button type="submit" class="btn btn-primary px-4">Save Changes</button>
              <a href="/posts/<%= post.id %>" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>