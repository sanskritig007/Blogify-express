<%- include('partials/header') %>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="d-flex justify-content-between align-items-center mb-5">
                <h2 class="h3 mb-0">Discover Stories</h2>
                <span class="badge bg-primary rounded-pill">
                    <%= posts.length %> Posts
                </span>
            </div>

            <div class="posts-container">
                <% posts.slice().reverse().forEach(post=> { %>
                    <div class="card mb-4 post-card">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <a href="#" class="username">@<%= post.username %></a>
                                </div>
                                <span class="timestamp">
                                    <%= new Date(post.createdAt).toLocaleDateString('en-US', { month: 'short' ,
                                        day: 'numeric' }) %>
                                </span>
                            </div>
                            <h5 class="card-title text-dark">
                                <%= post.content.length> 60 ? post.content.substring(0, 60) + '...' : post.content %>
                            </h5>
                            <p class="card-text text-muted mb-4">
                                <%= post.content.substring(0, 150) %>
                                    <%= post.content.length> 150 ? '...' : '' %>
                            </p>
                            <div class="d-flex justify-content-between align-items-center">
                                <a href="/posts/<%= post.id %>" class="btn btn-outline-primary">
                                    Read Full Story
                                </a>
                                <div class="text-muted small">
                                    <i class="bi bi-chat-left"></i> 0 comments
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }) %>
            </div>
        </div>
    </div>



    <%- include('partials/footer') %>