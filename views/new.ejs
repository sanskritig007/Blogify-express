<%- include('partials/header') %>

  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="card shadow-md p-2">
        <div class="card-body p-4">
          <h2 class="h4 mb-4">Express Your Thoughts</h2>
          <p class="text-muted small mb-4">Share something interesting with the community.</p>

          <form action="/posts" method="POST">
            <div class="mb-4">
              <label for="username" class="form-label">Display Name</label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0">@</span>
                <input type="text" name="username" id="username" class="form-control border-start-0 ps-0"
                  placeholder="your_handle" required>
              </div>
            </div>

            <div class="mb-4">
              <label for="content" class="form-label">Post Content</label>
              <textarea name="content" id="content" rows="6" class="form-control" placeholder="What's on your mind?"
                required></textarea>
              <div class="form-text">Suppports multiple lines of text.</div>
            </div>

            <div class="d-flex gap-2 pt-2">
              <button type="submit" class="btn btn-primary px-4">Publish Post</button>
              <a href="/posts" class="btn btn-outline-secondary">Discard</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>